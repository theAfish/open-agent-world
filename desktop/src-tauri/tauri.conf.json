{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Agent World",
  "version": "0.1.0",
  "identifier": "io.openagentworld.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [{ "label": "splash", "title": "Open Agent World", "width": 560, "height": 360, "resizable": false, "center": true, "devtools": false }],
    "security": { "capabilities": [], "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "shortDescription": "A visual workspace for AI agents, tools and resources",
    "category": "Productivity",
    "resources": { "../../.open-agent-world/desktop-payload/": "payload/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": true, "languages": ["English", "SimpChinese"] }
    }
  }
}
