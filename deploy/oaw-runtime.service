# Copy to /etc/systemd/system/oaw-runtime.service after adapting these paths/account.
# Prepare the deployment with --secure-cookie for access through HTTPS.
[Unit]
Description=Open Agent World published application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oaw
Group=oaw
WorkingDirectory=/opt/open-agent-world
ExecStart=/opt/open-agent-world/backend/.venv/bin/python -m backend.deploy --serve /srv/oaw/releases/customer-v1
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGINT
UMask=0077
# Optional credentials supplied by the operator; keep the file owner-readable only.
# EnvironmentFile=/etc/open-agent-world/runtime.env

[Install]
WantedBy=multi-user.target
