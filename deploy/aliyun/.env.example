# One copy, profile directory and remote volume per user. All values below are
# placeholders. Keep the completed file outside source control.
OPEN_AGENT_WORLD_DATA_ROOT=/var/lib/oaw
OAW_ORGANIZATION_ID=poc-org
OAW_WORKSPACE_ID=alice-workspace
OAW_OWNER_SUBJECT=exact-sub-from-verified-oidc-login
OAW_PUBLIC_ORIGIN=https://alice.oaw.example.com
OAW_OIDC_ISSUER=https://replace-with-user-pool-issuer
OAW_OIDC_DISCOVERY_URL=https://replace-with-user-pool-discovery-url
OAW_OIDC_CLIENT_ID=replace-with-client-id
OAW_OIDC_CLIENT_SECRET=replace-with-client-secret
# Single-user RAM OAuth 2.0 alternative (no CIAM instance):
# OAW_OIDC_ISSUER=https://oauth.aliyun.com
# OAW_OIDC_DISCOVERY_URL=https://oauth.aliyun.com/.well-known/openid-configuration
# OAW_OIDC_SCOPES=openid profile
# Provider-neutral OIDC settings. For IDaaS CIAM use:
# OAW_OIDC_SCOPES=openid profile USER_API
# OAW_OIDC_TOKEN_AUTH_METHOD=client_secret_post
# Confirm S256 PKCE support against the actual CIAM instance before deployment.
OAW_SESSION_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
OAW_ALIYUN_REGION=cn-hangzhou
OAW_ALIYUN_SANDBOX_API_KEY=replace-with-sandbox-team-api-key
OAW_ALIYUN_SANDBOX_TEMPLATE=replace-with-volume-compatible-template
OAW_ALIYUN_WORKSPACE_VOLUME=alice-private-volume
OAW_ALIYUN_SANDBOX_LIFETIME=600
# Set these only when required by the selected Volume. Grant this role access to
# the user's storage, not Sandbox administration or the OAW service credentials.
OAW_ALIYUN_SANDBOX_METADATA={}
# Only for a disposable smoke test, never for user data:
# OAW_ALIYUN_ALLOW_EPHEMERAL_PROFILE=1
# Only for a localhost browser callback during development:
# OAW_ALLOW_LOCAL_HTTP=1
