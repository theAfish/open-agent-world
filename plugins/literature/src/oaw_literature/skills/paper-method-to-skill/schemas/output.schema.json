{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oaw:literature:paper-method-to-skill:output:1",
  "title": "paper-method-to-skill output",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked"
      ]
    },
    "missing_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skill_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "method_status": {
      "enum": [
        "draft",
        "executable",
        "validated"
      ]
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "contract_check",
              "execution",
              "independent_scientific_validation"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "record_id",
          "kind",
          "scope",
          "outcome",
          "artifact_ids"
        ],
        "additionalProperties": false
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "status",
    "missing_capabilities",
    "sources",
    "limitations",
    "skill_artifact_id",
    "method_status",
    "missing_fields",
    "source_evidence_ids",
    "artifact_files",
    "validation_records",
    "next_steps"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "paper",
            "abstract",
            "document",
            "search",
            "code",
            "data",
            "user",
            "agent_inference"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "enum": [
            "metadata",
            "abstract",
            "fulltext",
            "si_code",
            "user_input",
            "not_read"
          ]
        }
      },
      "required": [
        "source_id",
        "kind",
        "locator",
        "access"
      ],
      "additionalProperties": false
    }
  }
}
