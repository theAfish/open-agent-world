{
  "name": "open-agent-world-frontend",
  "private": true,
  "overrides": {
    "matterviz": {
      "svelte-widgets": "1.6.1"
    }
  },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "build:pack-sdk": "node scripts/build-pack-sdk.mjs",
    "test": "vitest run src",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:packs": "node scripts/run-pack-e2e.mjs",
    "test:e2e:deployment": "playwright test -c playwright.deployment.config.ts",
    "test:e2e:ui": "playwright test -c playwright.ui.config.ts",
    "test:e2e:minister": "node scripts/run-e2e.mjs --minister"
  },
  "dependencies": {
    "@sigma/edge-curve": "3.1.0",
    "@xyflow/react": "^12.8.5",
    "d3-contour": "4.0.2",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-layout-forceatlas2": "0.10.1",
    "html-to-image": "1.11.13",
    "lucide-react": "^0.468.0",
    "matterviz": "0.7.0",
    "pdfjs-dist": "^5.4.624",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sigma": "3.0.3",
    "svelte": "5.57.0",
    "three": "0.185.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/d3-contour": "3.0.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.21",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
