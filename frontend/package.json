{
  "name": "open-agent-world-frontend",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/typecheck.mjs && vite build",
    "build:pack-sdk": "node scripts/build-pack-sdk.mjs",
    "test:pack-sdk": "node --test pack-sdk/build.test.mjs",
    "test": "vitest run src",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:graph": "node scripts/run-e2e.mjs --builtin-ui -c playwright.graph.config.ts",
    "test:e2e:packs": "node scripts/run-pack-e2e.mjs",
    "test:e2e:deployment": "playwright test -c playwright.deployment.config.ts",
    "test:e2e:publication": "playwright test -c playwright.publication.config.ts",
    "test:e2e:hosting": "playwright test -c playwright.hosting.config.ts",
    "test:e2e:ui": "playwright test -c playwright.ui.config.ts",
    "test:e2e:minister": "node scripts/run-e2e.mjs --minister",
    "prepare:packs": "node scripts/source-packs.mjs --prepare",
    "build:packs": "node scripts/source-packs.mjs",
    "predev": "node scripts/prepare-dev.mjs",
    "prebuild": "npm run build:pack-sdk && npm run prepare:packs"
  },
  "dependencies": {
    "@sigma/edge-curve": "3.1.0",
    "@xyflow/react": "^12.8.5",
    "d3-contour": "4.0.2",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-layout-forceatlas2": "0.10.1",
    "html-to-image": "1.11.13",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sigma": "3.0.3",
    "zustand": "^5.0.2",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/d3-contour": "3.0.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.21",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "@types/three": "0.185.4"
  }
}
